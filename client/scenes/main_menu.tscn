[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/main_menu.gd" id="1"]

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="CenterContainer" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="CenterContainer"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="CenterContainer/VBox"]
layout_mode = 2
text = "GLUNGUS'S FOREST"
horizontal_alignment = 1

[node name="Username" type="LineEdit" parent="CenterContainer/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(280, 0)
layout_mode = 2
placeholder_text = "username"

[node name="Password" type="LineEdit" parent="CenterContainer/VBox"]
unique_name_in_owner = true
layout_mode = 2
placeholder_text = "password (6+ characters)"
secret = true

[node name="Buttons" type="HBoxContainer" parent="CenterContainer/VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="LoginButton" type="Button" parent="CenterContainer/VBox/Buttons"]
layout_mode = 2
size_flags_horizontal = 3
text = "Log in"

[node name="RegisterButton" type="Button" parent="CenterContainer/VBox/Buttons"]
layout_mode = 2
size_flags_horizontal = 3
text = "Register"

[node name="Status" type="Label" parent="CenterContainer/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Pick a name and password to start."
horizontal_alignment = 1

[connection signal="pressed" from="CenterContainer/VBox/Buttons/LoginButton" to="." method="_on_login_pressed"]
[connection signal="pressed" from="CenterContainer/VBox/Buttons/RegisterButton" to="." method="_on_register_pressed"]
